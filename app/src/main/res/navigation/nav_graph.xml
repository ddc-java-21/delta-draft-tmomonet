<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:id="@+id/nav_graph"
  app:startDestination="@id/pre_login_fragment">
<!--TODO 7/25/25: ADD NAV DIRECTIONS TO WIRE WITH VIEWMODEL TO NEW FRAGMENTS-->
  <fragment
    android:id="@+id/pre_login_fragment"
    android:name="edu.cnm.deepdive.diceroller.controller.PreLoginFragment"
    tools:layout="@layout/fragment_pre_login">

    <action
      android:id="@+id/show_login"
      app:destination="@id/login_fragment"
      app:popUpTo="@id/nav_graph"/>

  </fragment>

  <fragment
    android:id="@+id/login_fragment"
    android:name="edu.cnm.deepdive.diceroller.controller.LoginFragment"
    android:label="Sign in to Diceroller"
    tools:layout="@layout/fragment_login">

  </fragment>

    <action
      android:id="@+id/show_details"
      app:destination="@id/login_fragment"/>
    <action
      android:id="@+id/show_pre_login"
      app:destination="@id/pre_login_fragment"
      app:popUpTo="@id/nav_graph"/>


  <!--  TODO Add Silent sign-in, sign in, note detail and other req'd fragments and actions-->

</navigation>